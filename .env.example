# Copy to `.env` and fill in. Never commit `.env`.
# Unlike the frontend, this process is server-side — real secrets belong here.
# Every variable below is checked by src/config/env.ts at boot: a missing one stops the server.

PORT=3000
NODE_ENV=development

# Supabase — the service_role key goes HERE, never in the frontend bundle
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed origin for CORS (the Vite dev server), also the base of Stripe's return URLs
CORS_ORIGIN=http://localhost:5173

# Stripe — matcha packs, auto-refill and the webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shopify — paid orders are mirrored into the store
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=

# AI providers — Claude (MMA steps 1 and 3, Tweak), GPT Image and gpt-4o-mini, NanoBanana Pro
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Edit tools (fingertips) — Replicate for SVG, Bria for No Subject, No Background, Expand and Erase
REPLICATE_API_TOKEN=
BRIAKEY=

# Cloudflare R2 — where every picture is stored
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Seals the .mina prompt files: 32 bytes as 64 hex characters (e.g. `openssl rand -hex 32`)
PROMPT_FILE_KEY=
