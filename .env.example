# Copy to `.env` and fill in. Never commit `.env`.
# Unlike the frontend, this process is server-side — real secrets belong here.

PORT=3000
NODE_ENV=development

# Supabase — the service_role key goes HERE, never in the frontend bundle
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed origin for CORS (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
