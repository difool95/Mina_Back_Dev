      "title": "Seedance — rules shared by every version (2.0 and 2.5)",
      "file": "seedance-common.md",
      "media": ["video"],
      "phases": ["video_prompt"],
      "kind": "engine",
      "specialized": false,
      "include_reason": "The resolved video engine is Seedance, on any version.",
      "match": { "all": [{ "fact": "engine", "op": "eq", "value": "seedance" }] }
