{
  "schema": "mina.knowledge.catalog.v1",
  "version": 1,
  "description": "Deterministic guide applicability. Conditions consume normalized target facts only; user brief text and source-image appearance are never routing evidence.",
  "guides": [
    {
      "key": "safe_wording",
      "title": "Provider-safe wording — content-safety phrasing",
      "file": "provider-safe-wording.md",
      "media": ["image", "video"],
      "phases": ["image_prompt", "video_prompt"],
      "kind": "safety",
      "specialized": true,
      "include_reason": "A target human, skin or wardrobe scope needs provider-safe wording on an image engine or Kling.",
      "match": {
        "any_of": [
          {
            "all": [
              { "fact": "media", "op": "eq", "value": "image" },
              { "fact": "human_safety_scope", "op": "includes_any", "value": ["person", "skin", "wardrobe"] }
            ]
          },
          {
            "all": [
              { "fact": "media", "op": "eq", "value": "video" },
              { "fact": "engine", "op": "eq", "value": "kling" },
              { "fact": "human_safety_scope", "op": "includes_any", "value": ["person", "skin", "wardrobe"] }
            ]
          }
        ]
      }
    },
    {
